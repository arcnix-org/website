---
import SiteLayout from './SiteLayout.astro';
import Icon from './Icon.astro';
import { releaseGuide, sitePath, tag, translate, type Locale } from '../lib/site';
interface Props { locale: Locale }
const { locale } = Astro.props;
const t = translate(locale);
const link = (path: string) => sitePath(locale, path);
const intro = t('Open files, edit code and run a terminal on your server over SSH. Every connection has its own desktop.', '通过 SSH 打开远程文件、编辑代码、运行终端。每台服务器都有自己的桌面。');
---
<SiteLayout locale={locale} title={t('A desktop workspace for SSH servers', '通过 SSH 管理服务器的桌面工作台')} description={intro}>
  <section class="hero"><div class="wrap hero-inner">
    <div class="hero-copy">
      <a class="hero-release" href={link(releaseGuide)}>{tag}<span></span>{t('Release notes','更新说明')}</a>
      <h1>{t('A desktop for','用桌面的方式')}<br/><em>{t('your servers.','管理服务器')}</em></h1>
      <p>{intro}</p>
      <div class="actions">
        <a class="button primary" id="downloads" href={link('downloads/')}><Icon name="download"/>{t('Download Arcnix','下载阿牛桌面')}</a>
        <a class="hero-docs" href={link('docs/quick-start/')}>{t('Quick start','快速上手')}</a>
      </div>
    </div>
    <a class="hero-preview" id="walkthrough" href={link('videos/images-pdf/')}>
      <img src="/media/viewers-tour.webp" alt={t('An image and a PDF open on the server desktop','在服务器桌面上查看图片和 PDF')} width="1440" height="900" fetchpriority="high" />
      <span><i class="play-glyph" aria-hidden="true"></i>{t('Watch the desktop in action','观看桌面操作实录')} <small>0:22</small></span>
    </a>
  </div></section>
  <section class="home-explore"><div class="wrap section">
    <h2>{t('Explore Arcnix','探索阿牛桌面')}</h2>
    <div class="directory">
      <a id="workspace" href={link('workspace/')}><Icon name="files"/><h3>{t('Server workspace','服务器工作台')}</h3><p>{t('Browse remote folders, edit a file and open a shell where you are working.','浏览远程目录、编辑文件，在当前目录打开终端。')}</p><b aria-hidden="true">→</b></a>
      <a id="operations" href={link('operations/')}><Icon name="monitor"/><h3>{t('Server operations','日常运维')}</h3><p>{t('Read service logs, inspect containers and find a task after reconnecting.','读取服务日志、检查容器，重新连接后继续查看任务结果。')}</p><b aria-hidden="true">→</b></a>
      <a href={link('videos/')}><Icon name="book"/><h3>{t('Video walkthroughs','操作实录')}</h3><p>{t('Follow short recordings of file transfers, the editor and local logging.','跟着短片操作文件传输、代码编辑器和本地日志设置。')}</p><b aria-hidden="true">→</b></a>
    </div>
  </div></section>
  <section class="wrap section"><h2>{t('New in ', '本版更新 · ')}{tag}</h2>
    <div class="page-links"><a href={link('docs/ssh-browser/')}>{t('Browse server-local sites from Linux','在 Linux 上访问服务器本地网页')} →</a><a href={link('videos/local-logs/')}>{t('Save session activity to this computer','将操作日志保存到本机')} →</a><a href={link(releaseGuide)}>{t('Release notes','完整更新说明')} →</a></div>
  </section>
  <script is:inline>
    // Previously shared homepage URLs used fragments instead of page paths.
    function followOldBookmark() {
      const routes = { '#workspace':'workspace/', '#operations':'operations/', '#downloads':'downloads/', '#walkthrough':'videos/' };
      const path = routes[location.hash];
      if (path) location.replace(new URL(path, document.querySelector('link[rel="canonical"]').href).pathname);
    }
    followOldBookmark();
    window.addEventListener('hashchange', followOldBookmark);
  </script>
</SiteLayout>
