---
interface Props { locale: 'en' | 'zh-CN' }
const { locale } = Astro.props;
const zh = locale === 'zh-CN';
const clips = [
  { id: 'player-tour', label: zh ? '视频播放' : 'Video player', title: zh ? '打开远程视频并跳播' : 'Open and seek through a remote video', time: '0:15' },
  { id: 'docker-tour', label: 'Docker', title: zh ? '启动容器，查看日志、卷和端口（开发版界面）' : 'Start a container and inspect logs, volumes and ports (development preview)', time: '0:21' },
  { id: 'monitor-tour', label: zh ? '服务器监控' : 'Monitor', title: zh ? '从网络概览查看服务日志' : 'Explore network activity and service logs', time: '0:18' },
  { id: 'workspace-tour', label: zh ? '代码编辑' : 'Code editor', title: zh ? '编辑远程交接文档' : 'Edit a remote handover note', time: '0:21' },
];
const first = clips[0];
---
<figure class="tour" aria-labelledby="tour-title">
  <nav class="tour-choices" aria-label={zh ? '选择操作实录' : 'Choose a walkthrough'}>
    {clips.map((clip, i) => <a href={`/media/${clip.id}.mp4`} aria-current={i === 0 ? 'true' : undefined}
      data-title={clip.title} data-time={clip.time} data-base={`/media/${clip.id}`}>{clip.label}</a>)}
  </nav>
  <div class="tour-stage">
    <video id="workspace-film" controls playsinline preload="none" width="1440" height="900"
      poster={`/media/${first.id}.webp`} aria-label={first.title}>
      <source src={`/media/${first.id}.mp4`} type="video/mp4" />
      <track kind="captions" srclang="en" label="English" src={`/media/${first.id}.en.vtt`} default={!zh} />
      <track kind="captions" srclang="zh-CN" label="简体中文" src={`/media/${first.id}.zh-CN.vtt`} default={zh} />
      <a href={`/media/${first.id}.mp4`}>{zh ? '打开 MP4' : 'Open MP4'}</a>
    </video>
    <button class="tour-play" type="button" aria-controls="workspace-film" hidden>
      <span aria-hidden="true" class="play-glyph"></span>{zh ? '播放实录' : 'Play demo'}
    </button>
  </div>
  <figcaption>
    <strong id="tour-title">{first.title}</strong>
    <span><time>{first.time}</time> · Windows x64</span>
  </figcaption>
</figure>
<script>
  const film = document.querySelector<HTMLVideoElement>('#workspace-film')!;
  const play = document.querySelector<HTMLButtonElement>('.tour-play')!;
  const choices = document.querySelectorAll<HTMLAnchorElement>('.tour-choices a');
  const title = document.querySelector('#tour-title')!;
  const duration = document.querySelector('.tour time')!;
  function start() {
    film.controls = true;
    play.hidden = true;
    film.play().catch(() => { /* Playback can still be started using native controls. */ });
  }
  if (film.canPlayType('video/mp4')) {
    film.controls = false;
    play.hidden = false;
    play.addEventListener('click', () => { start(); film.focus(); });
    for (const choice of choices) {
      choice.addEventListener('click', event => {
        if (event.metaKey || event.ctrlKey || event.altKey || event.shiftKey) return;
        event.preventDefault();
        if (!choice.hasAttribute('aria-current')) {
          film.pause();
          for (const item of choices) item.removeAttribute('aria-current');
          choice.setAttribute('aria-current', 'true');
          const base = choice.dataset.base!;
          film.poster = base + '.webp';
          film.querySelector('source')!.src = choice.href;
          film.querySelector('a')!.href = choice.href;
          for (const track of film.querySelectorAll('track')) {
            track.src = base + '.' + track.srclang + '.vtt';
          }
          title.textContent = choice.dataset.title!;
          film.setAttribute('aria-label', choice.dataset.title!);
          duration.textContent = choice.dataset.time!;
          film.load();
        }
        start();
      });
    }
  }
</script>
