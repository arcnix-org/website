---
import { render } from 'astro:content';
import { guidePath, guideRoutes } from '../lib/guides';
import Icon from '../components/Icon.astro';
import '../styles/site.css';
import '../styles/docs.css';

export const getStaticPaths = guideRoutes;
const { locale, slug, topics, article } = Astro.props;
const zh = locale === 'zh-cn';
const home = zh ? '/zh-cn/' : '/';
const docs = zh ? '使用文档' : 'Documentation';
const title = article?.data.title ?? docs;
const description = article?.data.description ?? (zh ? '从第一次 SSH 连接开始，了解 Arcnix 的桌面工具与服务器管理功能。' : 'Start with an SSH connection, then explore the desktop tools and server operations.');
const rendered = article ? await render(article) : undefined;
const Content = rendered?.Content;
const alternate = zh ? 'en' : 'zh-cn';
---
<!doctype html>
<html lang={zh ? 'zh-CN' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} · Arcnix</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="canonical" href={new URL(guidePath(locale, slug), Astro.site)} />
    <link rel="alternate" hreflang="en" href={new URL(guidePath('en', slug), Astro.site)} />
    <link rel="alternate" hreflang="zh-CN" href={new URL(guidePath('zh-cn', slug), Astro.site)} />
  </head>
  <body class="guide-shell">
    <a class="skip" href="#main">{zh ? '跳到正文' : 'Skip to content'}</a>
    <header><div class="wrap bar">
      <a class="brand" href={home}><img width="34" height="34" src="/brand.svg" alt="" />Arcnix</a>
      <a class="docs-home" href={guidePath(locale)}>{docs}</a>
      <div class="nav-tools">
        <a href={home + '#downloads'}>{zh ? '下载' : 'Downloads'}</a>
        <a class="language" href={guidePath(alternate, slug)} hreflang={zh ? 'en' : 'zh-CN'} lang={zh ? 'en' : 'zh-CN'}><Icon name="globe" />{zh ? 'English' : '中文'}</a>
      </div>
    </div></header>
    <main id="main" class:list={['wrap', article ? 'doc-layout' : 'doc-index']}>
      {article && <aside>
        <details class="doc-mobile-nav"><summary>{zh ? '文档目录' : 'Browse guides'}</summary>
          <nav aria-label={docs}>{topics.map(topic => <a href={guidePath(locale, topic.slug)} aria-current={topic.slug === slug ? 'page' : undefined}>{topic.title}</a>)}</nav>
        </details>
        <nav class="doc-sidebar" aria-label={docs}>
          <a class="doc-overview" href={guidePath(locale)}>{zh ? '文档目录' : 'All guides'}</a>
          {topics.map(topic => <a href={guidePath(locale, topic.slug)} aria-current={topic.slug === slug ? 'page' : undefined}>{topic.title}</a>)}
        </nav>
      </aside>}
      <article>
        <h1>{title}</h1>
        <p class="doc-lead">{description}</p>
        {Content ? <div class="doc-text"><Content /></div> :
          <div class="doc-topics">{topics.map(topic => <a href={guidePath(locale, topic.slug)}>
            <h2>{topic.title}</h2><p>{topic.description}</p>
          </a>)}</div>}
      </article>
    </main>
  </body>
</html>
