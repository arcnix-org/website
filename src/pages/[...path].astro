---
import { contentRoutes } from '../lib/routes';
import Downloads from '../components/Downloads.astro';
import Guide from '../components/Guide.astro';
import Operations from '../components/Operations.astro';
import VideoPages from '../components/VideoPages.astro';
import Workspace from '../components/Workspace.astro';

export const getStaticPaths = contentRoutes;
const page = Astro.props;
---
{page.type === 'guide' && <Guide {...page.guide} />}
{page.type === 'workspace' && <Workspace locale={page.locale} />}
{page.type === 'operations' && <Operations locale={page.locale} />}
{page.type === 'downloads' && <Downloads locale={page.locale} />}
{page.type === 'videos' && <VideoPages locale={page.locale} />}
{page.type === 'film' && <VideoPages locale={page.locale} clip={page.clip} />}
